@inherits LayoutComponentBase
@inject NavigationManager Nav

@* App-wide shell powered by MudBlazor.
   - MudThemeProvider applies our minimalist nautical palette.
   - MudPopoverProvider / MudDialogProvider / MudSnackbarProvider are required once, at the root.
   - MudLayout gives us the header + scrollable content region. *@

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="true" Color="Color.Transparent" Class="app-bar">
        <MudIconButton Icon="@Icons.Material.Filled.Sailing"
                       Color="Color.Inherit"
                       OnClick="GoHome"
                       aria-label="Main menu" />
        <MudText Typo="Typo.h6" Class="ml-2 app-bar-title">
            Battleship
        </MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Text"
                   Color="Color.Inherit"
                   StartIcon="@Icons.Material.Filled.Menu"
                   OnClick="GoHome">
            Menu
        </MudButton>
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-6 px-4 px-sm-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    // A restrained, minimalist theme with a single nautical-blue accent.
    // All other chrome colors come from MudBlazor's light defaults.
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#1e3f66",
            Secondary = "#2b5a87",
            AppbarBackground = "#1e3f66",
            AppbarText = "#f1f6fb",
            Background = "#f7fafc",
            Surface = "#ffffff",
            TextPrimary = "#1e3f66",
            TextSecondary = "#556677",
            DrawerBackground = "#ffffff",
            LinesDefault = "#e2e8ef",
            TableLines = "#e2e8ef",
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = new[] { "Roboto", "Helvetica", "Arial", "sans-serif" },
                FontSize = "0.95rem",
                LineHeight = "1.5",
            },
            H1 = new H1Typography { FontSize = "2rem", FontWeight = "600", LineHeight = "1.2" },
            H2 = new H2Typography { FontSize = "1.5rem", FontWeight = "600", LineHeight = "1.3" },
            H3 = new H3Typography { FontSize = "1.25rem", FontWeight = "500", LineHeight = "1.35" },
            H4 = new H4Typography { FontSize = "1.15rem", FontWeight = "500", LineHeight = "1.4" },
            H5 = new H5Typography { FontSize = "1.05rem", FontWeight = "500", LineHeight = "1.4" },
            H6 = new H6Typography { FontSize = "1rem", FontWeight = "500", LineHeight = "1.4" },
            Button = new ButtonTypography { TextTransform = "none", FontWeight = "500" },
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "8px",
            AppbarHeight = "56px",
        },
    };

    private void GoHome() => Nav.NavigateTo("/");
}
