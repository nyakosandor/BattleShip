@page "/setup"
@using BattleShip.App.Services
@using BattleShip.LanServer
@using BattleShip.LanServer.Client
@using BattleShip.LanServer.Contracts
@using Microsoft.AspNetCore.Components
@inject IGameEngine Engine
@inject IFleetRandomizer Randomizer
@inject GameHandoff Handoff
@inject ILanHost LanHost
@inject LanClientState ClientState
@inject NavigationManager Nav

<PageTitle>Fleet Setup</PageTitle>

<MudStack Spacing="5">
    <div>
        <MudText Typo="Typo.h4" Color="Color.Primary" GutterBottom="true">@Heading</MudText>
        <MudText Typo="Typo.body2" Color="Color.Default">
            Pick a ship from the palette, then tap a square to drop its bow.
            Rotate the ship to switch between horizontal and vertical placement.
        </MudText>
    </div>

    <MudGrid Spacing="4">
        <MudItem xs="12" md="8">
            <MudStack Spacing="3" AlignItems="AlignItems.Center">
                <BoardGrid Board="_board"
                           PreviewCoordinates="_preview"
                           PreviewValid="_previewValid"
                           OnCellClick="HandleCellClick"
                           OnCellEnter="HandleCellEnter"
                           OnCellLeave="HandleCellLeave" />

                @if (!string.IsNullOrEmpty(_statusMessage))
                {
                    <MudAlert Severity="@(_statusIsError ? Severity.Error : Severity.Info)"
                              Dense="true"
                              Variant="Variant.Text"
                              Class="w-100">
                        @_statusMessage
                    </MudAlert>
                }
            </MudStack>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudStack Spacing="3">
                <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                    <ShipPalette Orientation="_orientation"
                                 SelectedShipType="_selected"
                                 PlacedShipTypes="_placedTypes"
                                 OnSelect="HandleSelect"
                                 OnToggleOrientation="ToggleOrientation" />
                </MudPaper>

                <MudStack Spacing="2">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               FullWidth="true"
                               StartIcon="@Icons.Material.Filled.Shuffle"
                               Disabled="_submitting"
                               OnClick="AutoDeploy">
                        Auto-Deploy
                    </MudButton>

                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               FullWidth="true"
                               StartIcon="@Icons.Material.Filled.Refresh"
                               Disabled="_submitting"
                               OnClick="ClearBoard">
                        Clear Board
                    </MudButton>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Success"
                               FullWidth="true"
                               Size="Size.Large"
                               StartIcon="@Icons.Material.Filled.PlayArrow"
                               Disabled="@(!AllShipsPlaced || _submitting)"
                               OnClick="Ready">
                        @ReadyButtonLabel
                    </MudButton>
                </MudStack>

                <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Text">
                    <b>Tip:</b> Click the orientation button (or a placed ship)
                    to flip between horizontal and vertical.
                </MudAlert>
            </MudStack>
        </MudItem>
    </MudGrid>
</MudStack>

@code {
    private const int DefaultHostPort = 5100;

    [SupplyParameterFromQuery] public string? Mode { get; set; }

    private Board _board = new();
    private Orientation _orientation = Orientation.Horizontal;
    private ShipType? _selected;
    private HashSet<ShipType> _placedTypes = new();

    private HashSet<Coordinate>? _preview;
    private bool _previewValid;

    private string? _statusMessage;
    private bool _statusIsError;
    private bool _submitting;

    private enum SetupMode { SinglePlayer, LanHost, LanGuest }

    private SetupMode CurrentMode => Mode?.ToLowerInvariant() switch
    {
        "host" => SetupMode.LanHost,
        "guest" => SetupMode.LanGuest,
        _ => SetupMode.SinglePlayer,
    };

    private string Heading => CurrentMode switch
    {
        SetupMode.LanHost => "Deploy your fleet (LAN Host)",
        SetupMode.LanGuest => "Deploy your fleet (LAN Guest)",
        _ => "Deploy your fleet",
    };

    private string ReadyLabel => CurrentMode switch
    {
        SetupMode.LanHost => "Start Server",
        SetupMode.LanGuest => "Submit Fleet",
        _ => "Ready",
    };

    private string ReadyButtonLabel
    {
        get
        {
            var count = $"{_board.Ships.Count} / {Fleet.StandardComposition.Count}";
            if (_submitting) return $"Working... ({count})";
            return $"{ReadyLabel} ({count})";
        }
    }

    protected override void OnInitialized()
    {
        _selected = Fleet.StandardComposition.First();

        if (CurrentMode == SetupMode.LanGuest && !ClientState.IsConnected)
        {
            Nav.NavigateTo("/lan");
        }
    }

    private bool AllShipsPlaced => _placedTypes.Count == Fleet.StandardComposition.Count;

    private void HandleSelect(ShipType type)
    {
        _selected = type;
        ClearPreview();
    }

    private void ToggleOrientation()
    {
        _orientation = _orientation == Orientation.Horizontal
            ? Orientation.Vertical
            : Orientation.Horizontal;
        ClearPreview();
    }

    private void HandleCellEnter(Coordinate coord)
    {
        if (_selected is not ShipType type)
        {
            _preview = null;
            return;
        }

        var coords = Engine.BuildShipCoordinates(coord, type, _orientation);
        _preview = coords.ToHashSet();
        _previewValid = Engine.ValidatePlacement(_board, type, coord, _orientation).Success;
    }

    private void HandleCellLeave(Coordinate _) => ClearPreview();

    private void HandleCellClick(Coordinate coord)
    {
        if (_selected is not ShipType type)
        {
            SetStatus("Pick a ship from the palette first.", isError: true);
            return;
        }

        var result = Engine.TryPlaceShip(_board, type, coord, _orientation);
        if (!result.Success)
        {
            SetStatus(FormatError(result.Error), isError: true);
            return;
        }

        _placedTypes.Add(type);
        _selected = Fleet.StandardComposition.FirstOrDefault(t => !_placedTypes.Contains(t));
        if (_selected is null)
        {
            SetStatus("Fleet deployed. Press Ready when you're set.", isError: false);
        }
        else
        {
            SetStatus($"Placed {type.DisplayName()}. Next: {_selected.Value.DisplayName()}.", isError: false);
        }

        ClearPreview();
    }

    private void AutoDeploy()
    {
        ClearBoardState();
        if (Randomizer.AutoDeploy(_board))
        {
            foreach (var type in Fleet.StandardComposition)
            {
                _placedTypes.Add(type);
            }
            _selected = null;
            SetStatus("Auto-deployed a random legal fleet.", isError: false);
        }
        else
        {
            SetStatus("Auto-deploy failed. Please try again.", isError: true);
        }
        ClearPreview();
    }

    private void ClearBoard()
    {
        ClearBoardState();
        _selected = Fleet.StandardComposition.First();
        SetStatus("Board cleared.", isError: false);
        ClearPreview();
    }

    private async Task Ready()
    {
        if (!AllShipsPlaced || _submitting) return;
        _submitting = true;
        try
        {
            switch (CurrentMode)
            {
                case SetupMode.LanHost:
                    await StartHostAsync();
                    break;
                case SetupMode.LanGuest:
                    await SubmitGuestFleetAsync();
                    break;
                default:
                    Handoff.Submit(_board);
                    Nav.NavigateTo("/play");
                    break;
            }
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task StartHostAsync()
    {
        try
        {
            await LanHost.StartAsync("Host", _board, DefaultHostPort);
        }
        catch (Exception ex)
        {
            SetStatus($"Failed to start server: {ex.Message}", isError: true);
            return;
        }

        var identity = LanHost.HostIdentity;
        if (LanHost.Session is null || identity is null)
        {
            SetStatus("Server started but no host identity is available.", isError: true);
            return;
        }

        var hostClient = new LocalLanClient(LanHost.Session, identity);
        ClientState.AttachHostClient(hostClient);
        Nav.NavigateTo("/match");
    }

    private async Task SubmitGuestFleetAsync()
    {
        var client = ClientState.Client;
        if (client is null)
        {
            Nav.NavigateTo("/lan");
            return;
        }

        var placements = _board.Ships
            .Select(ship => new PlacementDto(
                ship.Type,
                new CoordinateDto(ship.Coordinates[0].X, ship.Coordinates[0].Y),
                ship.Orientation))
            .ToList();

        var result = await client.DeployAsync(placements);
        if (!result.Success)
        {
            var prefix = result.NetworkError ? "Lost connection to host" : "Host rejected the fleet";
            SetStatus($"{prefix}: {result.Message}", isError: true);
            return;
        }

        Nav.NavigateTo("/match");
    }

    private void ClearBoardState()
    {
        _board = new Board();
        _placedTypes.Clear();
    }

    private void ClearPreview() => _preview = null;

    private void SetStatus(string message, bool isError)
    {
        _statusMessage = message;
        _statusIsError = isError;
    }

    private static string FormatError(PlacementError error) => error switch
    {
        PlacementError.OutOfBounds => "That placement runs off the board.",
        PlacementError.Overlaps => "That spot overlaps another ship.",
        PlacementError.DuplicateShipType => "That ship has already been placed.",
        _ => "Placement rejected.",
    };
}
