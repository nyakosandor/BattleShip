@page "/play"
@using System.Threading
@using BattleShip.App.Services
@inject IGameEngine Engine
@inject IFleetRandomizer Randomizer
@inject IAiPlayerFactory AiFactory
@inject GameHandoff Handoff
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Battleship</PageTitle>

@if (_playerBoard is null || _aiBoard is null)
{
    <p>Preparing your fleet...</p>
}
else
{
    <div class="play-page">
        <div class="play-header">
            <h1>@StatusTitle</h1>
            <p class="play-subtitle">@StatusSubtitle</p>
        </div>

        <div class="boards-row">
            <div class="board-panel">
                <h2 class="board-label">Enemy waters</h2>
                <BoardGrid Board="_aiBoard"
                           HideShips="true"
                           OnCellClick="HandlePlayerShot" />
                <div class="board-stats">
                    Ships remaining: @ShipsRemaining(_aiBoard) / @Fleet.StandardComposition.Count
                </div>
            </div>

            <div class="board-panel">
                <h2 class="board-label">Your fleet</h2>
                <BoardGrid Board="_playerBoard" />
                <div class="board-stats">
                    Ships remaining: @ShipsRemaining(_playerBoard) / @Fleet.StandardComposition.Count
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_sunkMessage))
        {
            <div class="sunk-banner @(_sunkByPlayer ? "sunk-enemy" : "sunk-friendly")">
                @_sunkMessage
            </div>
        }

        <div class="shot-log" aria-live="polite">
            <h3>Log</h3>
            <ol>
                @foreach (var entry in _log.Take(8))
                {
                    <li>@entry</li>
                }
            </ol>
        </div>
    </div>

    @if (_winner is not null)
    {
        <div class="endgame-overlay">
            <div class="endgame-card">
                <h2>@(_winner == Winner.Player ? "Victory!" : "Defeat")</h2>
                <p>
                    @(_winner == Winner.Player
                        ? "You sank the enemy fleet."
                        : "Your fleet has been destroyed.")
                </p>
                <div class="endgame-actions">
                    <button type="button" class="btn btn-primary" @onclick="PlayAgain">Play Again</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="BackToMenu">Main Menu</button>
                </div>
            </div>
        </div>
    }
}

@code {
    private enum Turn { Player, Ai }
    private enum Winner { Player, Ai }

    private const int AiDelayMsMin = 1000;
    private const int AiDelayMsMax = 2000;
    private const int SunkBannerMs = 2200;

    private Board? _playerBoard;
    private Board? _aiBoard;
    private IAiPlayer? _ai;
    private Turn _turn = Turn.Player;
    private Winner? _winner;
    private bool _aiThinking;
    private readonly List<string> _log = new();

    private string? _sunkMessage;
    private bool _sunkByPlayer;
    private int _sunkBannerToken;

    private readonly CancellationTokenSource _cts = new();
    private readonly Random _turnRng = new();

    protected override void OnInitialized()
    {
        var board = Handoff.Take();
        if (board is null)
        {
            Nav.NavigateTo("/setup");
            return;
        }
        _playerBoard = board;

        _aiBoard = new Board();
        if (!Randomizer.AutoDeploy(_aiBoard))
        {
            Nav.NavigateTo("/setup");
            return;
        }

        _ai = AiFactory.Create(_aiBoard.Size);
        _turn = Turn.Player;
        _log.Insert(0, "Battle commenced. Take your first shot.");
    }

    private string StatusTitle => _winner switch
    {
        Winner.Player => "You win",
        Winner.Ai => "You lose",
        _ => _turn == Turn.Player ? "Your turn" : "Enemy turn",
    };

    private string StatusSubtitle => _winner is not null
        ? "Match complete."
        : _aiThinking
            ? "Enemy is taking aim..."
            : _turn == Turn.Player
                ? "Click a square on the enemy waters to fire."
                : "Waiting on enemy fire.";

    private static int ShipsRemaining(Board board) =>
        board.Ships.Count(s => !s.IsSunk);

    private async Task HandlePlayerShot(Coordinate coord)
    {
        if (_winner is not null) return;
        if (_turn != Turn.Player) return;
        if (_aiThinking) return;
        if (_aiBoard is null) return;

        var result = Engine.ProcessShot(_aiBoard, coord);

        if (result.Outcome == ShotOutcome.Invalid)
        {
            return;
        }

        AppendLog(PlayerShotLogLine(result));

        if (result.Outcome == ShotOutcome.Sunk && result.ShipHit is Ship sunk)
        {
            ShowSunk($"Enemy {sunk.Type.DisplayName()} sunk!", byPlayer: true);
        }

        if (result.FleetDestroyed)
        {
            _winner = Winner.Player;
            AppendLog("All enemy ships destroyed.");
            return;
        }

        _turn = Turn.Ai;
        _aiThinking = true;
        StateHasChanged();

        try
        {
            await RunAiTurnAsync(_cts.Token);
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            _aiThinking = false;
        }
    }

    private async Task RunAiTurnAsync(CancellationToken ct)
    {
        if (_ai is null || _playerBoard is null) return;

        var delay = _turnRng.Next(AiDelayMsMin, AiDelayMsMax + 1);
        await Task.Delay(delay, ct);

        var shot = _ai.NextShot();
        var result = Engine.ProcessShot(_playerBoard, shot);
        _ai.RegisterResult(result);

        AppendLog(AiShotLogLine(result));

        if (result.Outcome == ShotOutcome.Sunk && result.ShipHit is Ship sunk)
        {
            ShowSunk($"Your {sunk.Type.DisplayName()} was sunk!", byPlayer: false);
        }

        if (result.FleetDestroyed)
        {
            _winner = Winner.Ai;
            AppendLog("Your fleet has been destroyed.");
            return;
        }

        _turn = Turn.Player;
    }

    private void AppendLog(string entry) => _log.Insert(0, entry);

    private static string PlayerShotLogLine(ShotResult r) => r.Outcome switch
    {
        ShotOutcome.Hit => $"You hit at {Format(r.Coordinate)}.",
        ShotOutcome.Sunk => $"You sank the enemy {r.ShipHit?.Type.DisplayName()} at {Format(r.Coordinate)}.",
        ShotOutcome.Miss => $"You missed at {Format(r.Coordinate)}.",
        _ => $"Invalid shot at {Format(r.Coordinate)}.",
    };

    private static string AiShotLogLine(ShotResult r) => r.Outcome switch
    {
        ShotOutcome.Hit => $"Enemy hit at {Format(r.Coordinate)}.",
        ShotOutcome.Sunk => $"Enemy sank your {r.ShipHit?.Type.DisplayName()} at {Format(r.Coordinate)}.",
        ShotOutcome.Miss => $"Enemy missed at {Format(r.Coordinate)}.",
        _ => $"Enemy fired invalidly at {Format(r.Coordinate)}.",
    };

    private static string Format(Coordinate c) => $"{(char)('A' + c.X)}{c.Y + 1}";

    private void ShowSunk(string message, bool byPlayer)
    {
        _sunkMessage = message;
        _sunkByPlayer = byPlayer;
        var token = ++_sunkBannerToken;
        _ = ClearSunkBannerAfterDelayAsync(token);
    }

    private async Task ClearSunkBannerAfterDelayAsync(int token)
    {
        try
        {
            await Task.Delay(SunkBannerMs, _cts.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (token != _sunkBannerToken) return;
        _sunkMessage = null;
        StateHasChanged();
    }

    private void PlayAgain() => Nav.NavigateTo("/setup");
    private void BackToMenu() => Nav.NavigateTo("/");

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
