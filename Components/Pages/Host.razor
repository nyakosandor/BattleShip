@page "/host"
@using BattleShip.App.Services
@using BattleShip.LanServer
@using BattleShip.LanServer.Contracts
@inject ILanHost LanHost
@inject GameHandoff Handoff
@inject NavigationManager Nav
@implements IAsyncDisposable

<PageTitle>Host LAN Game</PageTitle>

<div class="host-page">
    <h1>LAN Host</h1>
    <p class="subtitle">@Subtitle</p>

    @if (_errorMessage is not null)
    {
        <div class="alert alert-danger">@_errorMessage</div>
    }

    @if (LanHost.IsRunning)
    {
        <div class="host-panel">
            <h2 class="host-label">Server running</h2>
            <dl class="host-info">
                <dt>Bound to</dt>
                <dd><code>@(LanHost.BaseAddress ?? "unknown")</code></dd>
                @if (LanHost is LanServer.LanHost concrete && !string.IsNullOrEmpty(concrete.LanAddress))
                {
                    <dt>LAN address</dt>
                    <dd><code>@concrete.LanAddress</code></dd>
                }
                <dt>Phase</dt>
                <dd>@FormatPhase(_session?.Phase)</dd>
                <dt>Guest</dt>
                <dd>@(_session?.HasGuest == true ? "connected" : "waiting...")</dd>
            </dl>

            <div class="host-actions">
                <button type="button" class="btn btn-outline-danger" @onclick="StopAsync">Stop Server</button>
                <button type="button" class="btn btn-link" @onclick='() => Nav.NavigateTo("/")'>Main menu</button>
            </div>

            <details class="host-help">
                <summary>How to test from Postman / curl</summary>
                <p>With the server running, try:</p>
                <ul>
                    <li><code>GET @(LanHost.BaseAddress)/health</code> &rarr; <code>{"status":"ok"}</code></li>
                    <li><code>GET @(LanHost.BaseAddress)/state</code> &rarr; initial public game state</li>
                    <li>
                        <code>POST @(LanHost.BaseAddress)/connect</code> with JSON body
                        <code>{"name":"Challenger"}</code> &rarr; receives <code>playerId</code> + <code>token</code>
                    </li>
                    <li>
                        <code>POST @(LanHost.BaseAddress)/action/deploy</code> with
                        <code>Authorization: Bearer &lt;token&gt;</code> and a 5-ship placement array
                    </li>
                    <li>
                        <code>POST @(LanHost.BaseAddress)/action/fire</code> with a
                        <code>{"target":{"x":0,"y":0}}</code> body and the same bearer token
                    </li>
                </ul>
            </details>
        </div>
    }
    else
    {
        <div class="host-panel">
            <p>Starting server...</p>
        </div>
    }
</div>

@code {
    private const int DefaultPort = 5100;

    private LanGameSession? _session;
    private string? _errorMessage;

    private string Subtitle => LanHost.IsRunning
        ? "Your Battleship server is listening on the local network."
        : "Preparing the server.";

    protected override async Task OnInitializedAsync()
    {
        if (LanHost.IsRunning)
        {
            _session = LanHost.Session;
            AttachSession();
            return;
        }

        var board = Handoff.Take();
        if (board is null)
        {
            Nav.NavigateTo("/setup?mode=host");
            return;
        }

        try
        {
            await LanHost.StartAsync("Host", board, DefaultPort);
            _session = LanHost.Session;
            AttachSession();
            LanHost.StateChanged += OnStateChanged;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to start server: {ex.Message}";
        }
    }

    private void AttachSession()
    {
        if (_session is null) return;
        _session.StateChanged += OnStateChanged;
    }

    private void OnStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task StopAsync()
    {
        await LanHost.StopAsync();
        Nav.NavigateTo("/");
    }

    public async ValueTask DisposeAsync()
    {
        LanHost.StateChanged -= OnStateChanged;
        if (_session is not null)
        {
            _session.StateChanged -= OnStateChanged;
        }
        await Task.CompletedTask;
    }

    private static string FormatPhase(GamePhase? phase) => phase switch
    {
        GamePhase.WaitingForClient => "waiting for a challenger",
        GamePhase.Deploying => "challenger is deploying",
        GamePhase.InProgress => "match in progress",
        GamePhase.Finished => "match finished",
        _ => "—",
    };
}
