@page "/lan"
@inject NavigationManager Nav

<PageTitle>LAN Game</PageTitle>

<div class="lan-page">
    <h1>Local Multiplayer</h1>
    <p class="subtitle">Face off against a friend on the same network.</p>

    <div class="lan-cards">
        <button type="button" class="lan-card" @onclick='() => Nav.NavigateTo("/setup?mode=host")'>
            <span class="lan-card-title">Host a Game</span>
            <span class="lan-card-desc">Start a local server, deploy your fleet, and wait for a challenger to connect.</span>
        </button>

        <button type="button" class="lan-card lan-card-disabled" disabled>
            <span class="lan-card-title">Join a Game <span class="lan-card-badge">soon</span></span>
            <span class="lan-card-desc">Connect to a host's LAN server. Arriving in Phase 5.</span>
        </button>
    </div>

    <button type="button" class="btn btn-link" @onclick='() => Nav.NavigateTo("/")'>
        Back to menu
    </button>
</div>
