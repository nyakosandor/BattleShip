@page "/lan"
@using System.ComponentModel.DataAnnotations
@using BattleShip.App.Services
@using BattleShip.LanServer.Client
@inject LanClientState ClientState
@inject NavigationManager Nav

<PageTitle>LAN Game</PageTitle>

<MudStack Spacing="6" Class="mx-auto" Style="max-width: 640px;">
    <div>
        <MudText Typo="Typo.h3" Color="Color.Primary" GutterBottom="true">Local Multiplayer</MudText>
        <MudText Typo="Typo.body1" Color="Color.Default">
            Face off against a friend on the same network.
        </MudText>
    </div>

    <MudStack Spacing="3">
        <MenuTile Icon="@Icons.Material.Filled.CastConnected"
                  Title="Host a Game"
                  Description="Start a local server, deploy your fleet, and wait for a challenger to connect."
                  OnClick="@(() => Nav.NavigateTo("/setup?mode=host"))" />

        <MudPaper Elevation="0" Outlined="true" Class="pa-5">
            <MudStack Spacing="3">
                <div>
                    <MudText Typo="Typo.h6">Join a Game</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Default">
                        Connect to a host's LAN server using their address.
                    </MudText>
                </div>

                <EditForm Model="_form" OnValidSubmit="ConnectAsync">
                    <DataAnnotationsValidator />

                    <MudStack Spacing="3">
                        <MudGrid Spacing="3">
                            <MudItem xs="12" sm="8">
                                <MudTextField @bind-Value="_form.Address"
                                              Label="Host address"
                                              Placeholder="192.168.1.23"
                                              For="@(() => _form.Address)"
                                              Disabled="_connecting"
                                              Variant="Variant.Outlined" />
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudNumericField @bind-Value="_form.Port"
                                                 Label="Port"
                                                 Min="1" Max="65535"
                                                 For="@(() => _form.Port)"
                                                 Disabled="_connecting"
                                                 Variant="Variant.Outlined" />
                            </MudItem>
                        </MudGrid>

                        <MudTextField @bind-Value="_form.Name"
                                      Label="Your name"
                                      Placeholder="Challenger"
                                      For="@(() => _form.Name)"
                                      Disabled="_connecting"
                                      Variant="Variant.Outlined" />

                        @if (!string.IsNullOrEmpty(_errorMessage))
                        {
                            <MudAlert Severity="Severity.Error" Dense="true" Variant="Variant.Text">
                                @_errorMessage
                            </MudAlert>
                        }

                        <MudButton ButtonType="ButtonType.Submit"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   FullWidth="true"
                                   Size="Size.Large"
                                   Disabled="_connecting">
                            @(_connecting ? "Connecting..." : "Connect")
                        </MudButton>
                    </MudStack>
                </EditForm>
            </MudStack>
        </MudPaper>
    </MudStack>

    <MudButton Variant="Variant.Text"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.ArrowBack"
               OnClick="@(() => Nav.NavigateTo("/"))"
               Class="align-self-start">
        Back to menu
    </MudButton>
</MudStack>

@code {
    private readonly JoinForm _form = new();
    private bool _connecting;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        // If we're returning to /lan after an earlier session, make sure any residual client is cleaned up.
        if (ClientState.IsConnected)
        {
            await ClientState.DisposeAndClearAsync();
        }
    }

    private async Task ConnectAsync()
    {
        _errorMessage = null;

        if (!Uri.TryCreate($"http://{_form.Address.Trim()}:{_form.Port}/", UriKind.Absolute, out var baseUri))
        {
            _errorMessage = "Address must be a plain hostname or IP (no scheme, no path).";
            return;
        }

        _connecting = true;
        try
        {
            var result = await LanHttpClient.ConnectAsync(baseUri, _form.Name.Trim());
            if (!result.Success || result.Value is null)
            {
                _errorMessage = result.NetworkError
                    ? $"Couldn't reach {baseUri.Host}:{baseUri.Port}. {result.Message}"
                    : $"Host rejected the connection: {result.Message}";
                return;
            }

            ClientState.AttachGuestClient(result.Value, baseUri.ToString().TrimEnd('/'));
            Nav.NavigateTo("/setup?mode=guest");
        }
        finally
        {
            _connecting = false;
        }
    }

    private sealed class JoinForm
    {
        [Required(ErrorMessage = "Host address is required.")]
        public string Address { get; set; } = string.Empty;

        [Range(1, 65535, ErrorMessage = "Port must be between 1 and 65535.")]
        public int Port { get; set; } = 5100;

        [Required(ErrorMessage = "Pick a name so the host can see you.")]
        [StringLength(32, ErrorMessage = "Name must be 32 characters or fewer.")]
        public string Name { get; set; } = string.Empty;
    }
}
